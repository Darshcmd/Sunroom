{
  "Comment": "Create three thumbnail sizes for each upload and notify the owner when processing finishes.",
  "StartAt": "BeginProcessing",
  "States": {
    "BeginProcessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "action": "begin_processing",
          "photoId.$": "$.photoId"
        }
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "BeginDecision"
    },
    "BeginDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision",
          "StringEquals": "SKIP",
          "Next": "Done"
        }
      ],
      "Default": "CreateThumbnails"
    },
    "CreateThumbnails": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "action": "create_thumbnails",
          "photoId.$": "$.photoId"
        }
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkReady"
    },
    "MarkReady": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "action": "mark_ready",
          "photoId.$": "$.photoId"
        }
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "ReadyDecision"
    },
    "ReadyDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision",
          "StringEquals": "SKIP",
          "Next": "Done"
        }
      ],
      "Default": "Notify"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "action": "mark_failed",
          "photoId.$": "$.photoId",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "FailureDecision"
    },
    "FailureDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision",
          "StringEquals": "SKIP",
          "Next": "Done"
        }
      ],
      "Default": "Notify"
    },
    "Notify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WorkflowFunctionArn}",
        "Payload": {
          "action": "notify",
          "photoId.$": "$.photoId",
          "status.$": "$.status"
        }
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notificationError",
          "Next": "Done"
        }
      ],
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
